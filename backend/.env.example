PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-secret-in-production
# Required in production: JWT_SECRET (>=32 chars) and FRONTEND_URL (your live SPA origin)

# Auth cookies (defaults work when SPA and API share a site, e.g. app.example.com + api.example.com)
# COOKIE_SAMESITE=strict
# For fully different domains (e.g. Vercel + Render), use:
# COOKIE_SAMESITE=none
# COOKIE_DOMAIN=.example.com

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/musafir_crm?retryWrites=true&w=majority
MONGODB_DB_NAME=musafir_crm

# First admin (run: npm run seed:admin) — change password before production
SEED_ADMIN_EMAIL=admin@divniq.com
SEED_ADMIN_PASSWORD=change-me-strong-admin-password
SEED_ADMIN_NAME=System Admin

WEBSITE_API_KEY=change-me-website-public-lead-key
WEBSITE_ORIGIN=https://your-marketing-site.example.com

# Meta (Facebook) Lead Ads webhooks
META_VERIFY_TOKEN=change-me-meta-verify-token
META_ACCESS_TOKEN=change-me-meta-graph-access-token

# Google Ads Lead Form Extension webhook
GOOGLE_WEBHOOK_KEY=change-me-google-webhook-key

# Optional: system Chromium for PDF quotations on Linux servers
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
